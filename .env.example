# Copy to .env.local. Never commit real credentials.
# Active email transport: Resend, with an owned and verified sender domain.
RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM=Castle Elevator <support@your-verified-domain.example>
ADMIN_EMAIL=your-admin@example.com

# Per-process rate limiting; use a trusted proxy and shared limiter at scale.
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_MS=3600000

# Confirm the actual public domain before configuring production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CRM/database persistence is not implemented yet.
# Add a database only with the authenticated commercial-system implementation.
